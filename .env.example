# ─────────────────────────────────────────────────────────────
# PaperChai environment — copy to .env.local and fill what you have.
# Smart imports (resume / reference site / LinkedIn) need ONE AI key.
# Google Business import needs the Google Places key.
# With no keys set, the app still works via the manual form.
# ─────────────────────────────────────────────────────────────

# --- AI provider (any ONE enables smart imports) ---
# First key present wins, in this order: Anthropic → Gemini → OpenAI.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider even if multiple keys are set.
# One of: anthropic | google | openai
BOOKAI_AI_PROVIDER=

# Optional: override default models.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini

# --- Google Business / Maps import ---
# SerpAPI is preferred (reviews, photos, hours without a Google Cloud project).
SERP_API_KEY=
# Optional fallback: Google Places API (New) — photos use /api/photo proxy.
GOOGLE_PLACES_API_KEY=

# --- Email + OTP gate ---
# When email is configured, generation is gated behind OTP verification
# (Brila-style). When unset, the gate is skipped. SES is preferred over Gmail.
#
# Verified sender identity / domain (e.g. dev@somanathkhadanga.com).
EMAIL_FROM=

# Amazon SES via SMTP (preferred). Create SMTP credentials in the SES console
# (these are NOT your AWS access keys). Set the region you verified in.
# NOTE: a new SES account is in "sandbox" — it can only email VERIFIED
# recipients until you request production access.
SES_REGION=
# (or set the full host directly instead of SES_REGION)
SES_SMTP_HOST=
SES_SMTP_USER=
SES_SMTP_PASSWORD=

# Gmail fallback (used only if SES isn't set). Use a Gmail App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: secret used to sign the verified-session cookie. Set any random
# string in production; falls back to a dev default if unset.
BOOKAI_SECRET=

# Optional: how long a verified email session lasts (days). Default 30.
# BOOKAI_SESSION_DAYS=30

# --- Rate limits (Postgres-backed; protects paid APIs from abuse) ---
# Expensive routes: extract + generate (per IP and per email, per hour).
# RATE_LIMIT_EXPENSIVE_HOUR=60
# OTP requests per IP+email per 15 minutes.
# RATE_LIMIT_OTP_15MIN=6
# Image proxy (/api/img, /api/photo) per IP per hour.
# RATE_LIMIT_PROXY_HOUR=120
# OTP verify attempts per IP+email per hour.
# RATE_LIMIT_AUTH_HOUR=30

# --- Database (Postgres) ---
# Stores accounts, generated sites, plans and OTPs. Any Postgres works — only
# the connection string changes. When unset, the app uses in-memory stores.
#   Local:    postgresql://localhost:5432/bookai_dev
#   Neon:     postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#   Supabase: postgresql://postgres:PASS@db.xxx.supabase.co:5432/postgres
# Tables are created automatically on first use.
DATABASE_URL=
# Vercel Neon integration may prefix vars (bookAi_DATABASE_URL, etc.) — the app
# reads those automatically. You can also add plain DATABASE_URL in Vercel.

# --- Published site URLs ---
# App origin for absolute links (emails, OG tags, copy-to-clipboard).
NEXT_PUBLIC_APP_URL=https://paperchaiapp.com

# Optional: enable wildcard-subdomain sites (glamzone.paperchaiapp.com).
# Set this to your APEX domain (no protocol, no path). When set, published URLs
# become https://<slug>.<domain> and proxy.ts routes them to /[slug].
# Leave blank to keep path-based URLs (paperchaiapp.com/glamzone).
# Requires a *.<domain> wildcard DNS record — see docs/CUSTOM-DOMAINS.md.
NEXT_PUBLIC_SITE_DOMAIN=paperchaiapp.com
# Local dev tip: <slug>.localhost:3000 works automatically (no DNS needed).
